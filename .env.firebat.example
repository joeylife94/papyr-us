# Firebat-local service binding
HOST_PORT=8801

# PostgreSQL (generated automatically by scripts/deploy-firebat.sh on first run)
POSTGRES_USER=papyr
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=papyr

# Required production security values (generated automatically on first run)
JWT_SECRET=__JWT_SECRET__
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_EMAILS=admin@firebat.local
ENFORCE_AUTH_WRITES=true
ALLOW_ADMIN_PASSWORD=false
RATE_LIMIT_ENABLED=true

# Application mode
PAPYR_MODE=team
FEATURE_TEAMS=true
FEATURE_ADMIN=true
FEATURE_CALENDAR=true
FEATURE_TEMPLATES=true
FEATURE_AUTOMATION=false
FEATURE_NOTIFICATIONS=true
FEATURE_COLLABORATION=true
COLLAB_REQUIRE_AUTH=1

# Tailnet-only browser origin
CORS_ALLOWED_ORIGINS=https://joey-dev.tail6bd8d2.ts.net:8446
CORS_ALLOW_CREDENTIALS=true

# Redis is internal-only and used by the realtime adapter/cache layer
REDIS_ENABLED=true

# AI is optional. Leave empty to run without external AI calls.
OPENAI_API_KEY=

# Optional first admin seed. Leave all three empty to skip.
# The email should also be included in ADMIN_EMAILS.
FIREBAT_SEED_ADMIN_NAME=
FIREBAT_SEED_ADMIN_EMAIL=
FIREBAT_SEED_ADMIN_PASSWORD=

# Optional observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=true
LOG_LEVEL=info
